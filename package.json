{
  "name": "microsoft-todo-mcp-bridge",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Self-hosted remote MCP server for Microsoft To Do with delegated Microsoft OAuth",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "setup": "node scripts/setup.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test tests/*.test.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test:worker": "node --test tests/worker/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:worker",
    "security:check": "node scripts/check-public.mjs",
    "release:pack": "node scripts/release-pack.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261015.1",
    "miniflare": "5.20261012.0-beta",
    "typescript": "5.9.3",
    "wrangler": "4.151.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
